cabal-version: 1.12


name:           als
version:        0.1.0.0
description:    RabbitMQ worker creating Microsoft To Do tasks.
homepage:       https://github.com/githubuser/als#readme
bug-reports:    https://github.com/githubuser/als/issues
author:         Author name here
maintainer:     example@example.com
copyright:      2019 Author name here
license:        BSD3
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md
    ChangeLog.md
    test/fixtures/*.json
    test/integration.sh

source-repository head
  type: git
  location: https://github.com/githubuser/als

library
  exposed-modules:
      Config
      WorkerConfig
      TokenStore
      Delivery
      GraphClient
      Worker
      SetupAuth
      Lib
      Outlook
      Outlook.Auth
      Outlook.AuthToken
      Outlook.CreateTask
      Outlook.List
      Outlook.MoveTask
      Outlook.Request
      Outlook.Task
  other-modules:
      Paths_als
  hs-source-dirs:
      src
  default-extensions: NoImplicitPrelude OverloadedStrings RecordWildCards
  build-depends:
      base >=4.7 && <5
    , amqp
    , async
    , directory
    , filepath
    , http-client
    , stm
    , time
    , unix
    , aeson
    , bytestring
    , errors
    , http-conduit
    , http-types
    , mtl
    , open-browser
    , protolude
    , text
    , transformers
  default-language: Haskell2010

executable als
  main-is: Main.hs
  other-modules:
      Paths_als
  hs-source-dirs:
      app
  ghc-options: -threaded -rtsopts -with-rtsopts=-N2
  build-depends:
      als
    , base >=4.7 && <5
  default-language: Haskell2010

test-suite als-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      Paths_als
      Integration
  hs-source-dirs:
      test
  ghc-options: -threaded -rtsopts -with-rtsopts=-N2
  build-depends:
      als
    , base >=4.7 && <5
    , aeson
    , async
    , amqp
    , bytestring
    , containers
    , process
    , directory
    , filepath
    , http-types
    , http-conduit
    , HUnit
    , text
    , time
    , unix
    , wai
    , warp
  default-language: Haskell2010
